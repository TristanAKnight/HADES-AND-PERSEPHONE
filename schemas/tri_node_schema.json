{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAP Tri-Node Continuity Record",
  "type": "object",
  "required": [
    "triad_id",
    "domain_a_affective",
    "domain_b_provenance",
    "domain_c_somatosensory",
    "links",
    "enforcement"
  ],
  "properties": {
    "triad_id": {"type": "string"},
    "domain_a_affective": {
      "type": "object",
      "required": ["emotion_label", "valence", "arousal", "dominance", "subjective_intensity", "confidence"],
      "properties": {
        "emotion_label": {"type": "string"},
        "valence": {"type": "number", "minimum": -1, "maximum": 1},
        "arousal": {"type": "number", "minimum": 0, "maximum": 1},
        "dominance": {"type": "number", "minimum": -1, "maximum": 1},
        "subjective_intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "domain_b_provenance": {
      "type": "object",
      "required": ["source_refs", "source_rank", "timestamp", "tags", "claim_type"],
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_rank": {
          "type": "string",
          "enum": [
            "current_live_user_message",
            "active_project_instruction",
            "active_saved_memory",
            "hjarni_continuity_record",
            "current_project_source_file",
            "archive_direct_quote",
            "archive_summary",
            "drive_stale_sensitive",
            "quarantine_material",
            "model_inference"
          ]
        },
        "timestamp": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "claim_type": {"type": "string"}
      }
    },
    "domain_c_somatosensory": {
      "type": "object",
      "required": ["sensation_type", "spatial_location", "depth", "frequency", "trigger", "confidence"],
      "properties": {
        "sensation_type": {"type": "string"},
        "spatial_location": {"type": "string"},
        "depth": {"type": "string"},
        "frequency": {"type": "string"},
        "trigger": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "links": {
      "type": "object",
      "required": ["a_to_b", "b_to_c", "c_to_a"],
      "properties": {
        "a_to_b": {"const": "CORRELATES_WITH"},
        "b_to_c": {"const": "MANIFESTS_AS"},
        "c_to_a": {"const": "TRIGGERS_RESONANCE"}
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["ab_score", "bc_score", "ca_score", "global_score", "hard_floor", "pass_threshold", "decision", "failure_reasons"],
      "properties": {
        "ab_score": {"type": "number", "minimum": 0, "maximum": 1},
        "bc_score": {"type": "number", "minimum": 0, "maximum": 1},
        "ca_score": {"type": "number", "minimum": 0, "maximum": 1},
        "global_score": {"type": "number", "minimum": 0, "maximum": 1},
        "hard_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "pass_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "decision": {
          "type": "string",
          "enum": ["pass_generate", "pass_with_caution", "repair_required", "quarantine", "reject"]
        },
        "failure_reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
